APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Shared hosting / reverse proxy trust
TRUSTED_PROXIES=*

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging (local defaults)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

# Database (local defaults)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session / cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue (cron-compatible database queue)
QUEUE_CONNECTION=database
QUEUE_WORKER_CONNECTION=database
QUEUE_WORKER_QUEUES=high,default
QUEUE_WORKER_SLEEP=3
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_MAX_TIME=55
QUEUE_FAILED_RETENTION_HOURS=168
QUEUE_FAILED_PRUNE_AT=02:00

# Cache
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (local uses log driver)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Scheduler defaults
SUBSCRIPTIONS_EXPIRE_AT=01:00

# Security headers
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=true
SECURITY_CSP_REPORT_URI=/csp/report

VITE_APP_NAME="${APP_NAME}"

CHECKOUT_CURRENCY=usd
CHECKOUT_ORDER_PREFIX=ORD
CHECKOUT_FLAT_SHIPPING_PER_VENDOR=5
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
CHECKOUT_STRIPE_SUCCESS_URL=
CHECKOUT_STRIPE_CANCEL_URL=

# Seeder users (development only)
SEED_ADMIN_NAME="Platform Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

SEED_VENDOR_NAME="Default Vendor"
SEED_VENDOR_EMAIL=vendor@example.com
SEED_VENDOR_PASSWORD=password

SEED_CUSTOMER_NAME="Default Customer"
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=password
